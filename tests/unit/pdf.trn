namespace streaky/chromium

from /core/testing import assert
from /core/errors import throwable

function test-invalid-executable-raises-chromium-error none throws throwable;
    missing string = rust
        tempfile::tempdir().expect("create isolated browser fixture").path().join("missing-browser").to_string_lossy().into_owned()
    browser = instance browser-options; { executable = missing }
    printing = instance pdf-options;
    html = '<!doctype html><p>Browser failure</p>'
    caught bool = false
    try
        render-pdf; html, browser, printing
    catch chromium-error
        caught = true
    assert; caught
    return none
