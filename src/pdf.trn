namespace streaky/chromium

from /core/errors import throwable

public class chromium-error implements throwable
    message string = ''

    function construct; message string
        this.message = message

    function render string;
        return this.message

public class browser-options
    executable string|none = none
    timeout-ms int = 30000
    diagnostic-capacity int = 1000

public class pdf-options
    display-header-footer bool = false
    print-background bool = false
    prefer-css-page-size bool = false
    expand-disclosures bool = false
    paper-size string|none = none
    paper-width-mm float|none = none
    paper-height-mm float|none = none
    landscape bool = false
    margin-top-mm float|none = none
    margin-bottom-mm float|none = none
    margin-left-mm float|none = none
    margin-right-mm float|none = none
    scale float|none = none
    page-ranges string|none = none

public function find-executable string|none;
    # chromium/projection-path-text: discovery returns a native PathBuf without
    # a projected to_string_lossy member. Keep this small conversion inline;
    # remove it when discovery and native path text conversion project together.
    detected string = rust
        headless_chrome::browser::default_executable()
            .ok()
            .map(|path| path.to_string_lossy().into_owned())
            .unwrap_or_default()
    if detected == ''
        return none
    return detected

public function render-pdf bytes throws chromium-error; html ref string, browser ref browser-options, printing ref pdf-options
    viewport = instance viewport-options;
    loading = instance load-options;
    document = open-page; browser, viewport
    try
        document.set-html; html, loading
        return document.print-pdf; printing
    finally
        document.close;
