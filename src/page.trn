from /deps/serde-json import to_string as encode-native-json, Error as native-json-error

# The retained event bridge returns a heterogeneous Rust tuple. Source tuples are
# homogeneous; this stack record gives the inline crossing an exact source type.
private class event-poll
    text string|none = none
    stopped bool = false

# Private event-only Result carrier; remove with the retained native event bridge.
# This is stack storage for the exact Receiver/error alternative, not launch policy.
private class event-capture
    receiver (native-event-receiver of string)|none = none
    error string = ''

private owning interface cdp-client
    associated type navigation-response
    associated type frame-response
    associated type html-response
    associated type evaluation-response
    associated type viewport-response
    associated type layout-response
    associated type screenshot-response
    associated type print-response
    private function send-navigation navigation-response throws throwable; request Navigate
    private function send-frame frame-response throws throwable; request GetFrameTree
    private function send-html html-response throws throwable; request SetDocumentContent
    private function send-evaluation evaluation-response throws throwable; request Evaluate
    private function send-viewport viewport-response throws throwable; request SetDeviceMetricsOverride
    private function send-layout layout-response throws throwable; request GetLayoutMetrics
    private function send-screenshot screenshot-response throws throwable; request CaptureScreenshot
    private function send-print print-response throws throwable; request PrintToPDF

public class viewport-options
    width int = 1280
    height int = 720
    device-scale-factor float = 1.0
public class load-options
    base-url string|none = none
    wait-for-assets bool = true
    ready-selector string|none = none
    ready-expression string|none = none

public class screenshot-options
    format string = 'png'
    quality int|none = none
    full-page bool = false

private class page-state
    browser native-browser|none = none
    tab native-tab|none = none
    events (native-event-receiver of string)|none = none
    timeout-ms int = 30000
    injected-html bool = true
    error string = ''


private class paper-dimensions
    width float|none = none
    height float|none = none

private function require-page; state ref page-state
    if state.browser == none
        throw chromium-error; 'page is closed'

private function page-tab native-tab; state ref page-state
    tab = state.tab
    if tab != none
        return tab
    throw chromium-error; 'page is closed'
private function finish-operation; message string
    if message != ''
        throw chromium-error; move message


private function validate-viewport; viewport ref viewport-options
    if viewport.width <= 0 or viewport.width > 2147483647 or viewport.height <= 0 or viewport.height > 2147483647
        throw chromium-error; 'viewport dimensions must be positive 32-bit integers'
    if not viewport.device-scale-factor.finite or viewport.device-scale-factor <= 0.0
        throw chromium-error; 'device scale factor must be finite and positive'

private function validate-positive; value float|none, name string
    if value != none
        if not value.finite or value <= 0.0
            throw chromium-error; name + ' must be finite and positive'

private function validate-margin; value float|none, name string
    if value != none
        if not value.finite or value < 0.0
            throw chromium-error; name + ' must be finite and nonnegative'

private function millimetres-to-inches float|none; value float|none
    if value != none
        return value / 25.4
    return none

private function pdf-paper paper-dimensions; printing ref pdf-options
    dimensions = instance paper-dimensions;
    size = printing.paper-size
    if size != none
        if printing.paper-width-mm != none or printing.paper-height-mm != none
            throw chromium-error; 'named and custom paper sizes are mutually exclusive'
        switch
            case size == 'A3'
                dimensions.width = 297.0 / 25.4
                dimensions.height = 420.0 / 25.4
            case size == 'A4'
                dimensions.width = 210.0 / 25.4
                dimensions.height = 297.0 / 25.4
            case size == 'A5'
                dimensions.width = 148.0 / 25.4
                dimensions.height = 210.0 / 25.4
            case size == 'Letter'
                dimensions.width = 8.5
                dimensions.height = 11.0
            case size == 'Legal'
                dimensions.width = 8.5
                dimensions.height = 14.0
            case else
                throw chromium-error; 'unknown paper size: ' + size
    else
        if (printing.paper-width-mm == none) != (printing.paper-height-mm == none)
            throw chromium-error; 'custom paper width and height must be supplied together'
        validate-positive; printing.paper-width-mm, 'paper width'
        validate-positive; printing.paper-height-mm, 'paper height'
        width = printing.paper-width-mm
        height = printing.paper-height-mm
        if width != none
            dimensions.width = width / 25.4
        if height != none
            dimensions.height = height / 25.4
    validate-margin; printing.margin-top-mm, 'top margin'
    validate-margin; printing.margin-bottom-mm, 'bottom margin'
    validate-margin; printing.margin-left-mm, 'left margin'
    validate-margin; printing.margin-right-mm, 'right margin'
    scale = printing.scale
    if scale != none
        if not scale.finite or scale < 0.1 or scale > 2.0
            throw chromium-error; 'PDF scale must be finite and between 0.1 and 2.0'
    return move dimensions

public class page implements cdp-client
    associated type navigation-response = NavigateReturnObject
    associated type frame-response = GetFrameTreeReturnObject
    associated type html-response = SetDocumentContentReturnObject
    associated type evaluation-response = EvaluateReturnObject
    associated type viewport-response = SetDeviceMetricsOverrideReturnObject
    associated type layout-response = GetLayoutMetricsReturnObject
    associated type screenshot-response = CaptureScreenshotReturnObject
    associated type print-response = PrintToPDFReturnObject
    private state page-state

    private function construct; state page-state
        this.state = move state

    private function send-navigation navigation-response throws throwable; request Navigate
        tab = page-tab; this.state
        return tab.call_method; move request

    private function send-frame frame-response throws throwable; request GetFrameTree
        tab = page-tab; this.state
        return tab.call_method; move request

    private function send-html html-response throws throwable; request SetDocumentContent
        tab = page-tab; this.state
        return tab.call_method; move request

    private function send-evaluation evaluation-response throws throwable; request Evaluate
        tab = page-tab; this.state
        return tab.call_method; move request

    private function send-viewport viewport-response throws throwable; request SetDeviceMetricsOverride
        tab = page-tab; this.state
        return tab.call_method; move request

    private function send-layout layout-response throws throwable; request GetLayoutMetrics
        tab = page-tab; this.state
        return tab.call_method; move request

    private function send-screenshot screenshot-response throws throwable; request CaptureScreenshot
        tab = page-tab; this.state
        return tab.call_method; move request

    private function send-print print-response throws throwable; request PrintToPDF
        tab = page-tab; this.state
        return tab.call_method; move request


    function is-open bool;
        return this.state.browser != none

    mutable function navigate; url ref string, loading ref load-options
        this.state.injected-html = false
        try
            page-navigate; this, url, loading
        catch dependency-error as error
            throw chromium-error; move error.message
        catch integer-conversion-overflow as error
            throw chromium-error; move error.message
        catch coercion-error as error
            throw chromium-error; move error.message

    mutable function set-html; html ref string, loading ref load-options
        this.state.injected-html = true
        try
            page-set-html; this, html, loading
        catch dependency-error as error
            throw chromium-error; move error.message
        catch integer-conversion-overflow as error
            throw chromium-error; move error.message
        catch coercion-error as error
            throw chromium-error; move error.message

    mutable function set-viewport; viewport ref viewport-options
        try
            page-set-viewport; this, viewport
        catch dependency-error as error
            throw chromium-error; move error.message
        catch integer-conversion-overflow as error
            throw chromium-error; move error.message
        catch coercion-error as error
            throw chromium-error; move error.message

    mutable function wait-for-selector; selector ref string
        try
            page-wait-selector; this, selector
        catch dependency-error as error
            throw chromium-error; move error.message
        catch integer-conversion-overflow as error
            throw chromium-error; move error.message
        catch coercion-error as error
            throw chromium-error; move error.message

    mutable function wait-for; expression ref string
        try
            page-wait; this, expression
        catch dependency-error as error
            throw chromium-error; move error.message
        catch integer-conversion-overflow as error
            throw chromium-error; move error.message
        catch coercion-error as error
            throw chromium-error; move error.message

    mutable function evaluate document-value; expression ref string, await-promise bool
        try
            return page-evaluate; this, expression, await-promise
        catch dependency-error as error
            throw chromium-error; move error.message
        catch integer-conversion-overflow as error
            throw chromium-error; move error.message
        catch coercion-error as error
            throw chromium-error; move error.message

    mutable function screenshot bytes; options ref screenshot-options
        try
            return page-screenshot; this, options
        catch dependency-error as error
            throw chromium-error; move error.message
        catch integer-conversion-overflow as error
            throw chromium-error; move error.message
        catch coercion-error as error
            throw chromium-error; move error.message

    mutable function print-pdf bytes; printing ref pdf-options
        try
            return page-print; this, printing
        catch dependency-error as error
            throw chromium-error; move error.message
        catch integer-conversion-overflow as error
            throw chromium-error; move error.message
        catch coercion-error as error
            throw chromium-error; move error.message

    mutable function diagnostics document-value;
        try
            return page-diagnostics; this
        catch dependency-error as error
            throw chromium-error; move error.message
        catch integer-conversion-overflow as error
            throw chromium-error; move error.message
        catch coercion-error as error
            throw chromium-error; move error.message
        catch index-error as error
            throw chromium-error; move error.message
    mutable function close;
        if this.state.browser == none
            return
        message = page-close; this.state
        this.state.events = none
        this.state.tab = none
        this.state.browser = none
        finish-operation; move message

    function destruct;
        # Source owns the browser, tab and event receiver. Native Drop cleans up
        # on errors/scope exit; explicit close additionally reports CDP errors.
        this.state.events = none
        this.state.tab = none
        this.state.browser = none

# The private event setup bridge owns its native channel and error conversion.
# Retained callbacks and typed event policy still use chromium_events::capture;
# remove this crossing when that event ownership contract projects directly.
private function capture-events (native-event-receiver of string) throws chromium-error; owner ref native-browser, tab ref native-tab, capacity uint64, timeout uint64
    result event-capture = rust
        let captured = usize::try_from(capacity)
            .map_err(|_| "invalid diagnostic capacity".to_owned())
            .and_then(|capacity| crate::chromium_events::capture(
                &owner.get_ws_url(), tab.get_target_id(), capacity, timeout,
            ));
        match captured {
            Ok(receiver) => EventCapture { receiver: Some(receiver), error: String::new() },
            Err(error) => EventCapture { receiver: None, error },
        }
    captured = move result.receiver
    if captured != none
        return move captured
    throw chromium-error; move result.error

public function open-page shared ref page; browser ref browser-options, viewport ref viewport-options
    validate-viewport; viewport
    if browser.timeout-ms <= 0 or browser.timeout-ms > 2147483647
        throw chromium-error; 'timeout must be a positive 32-bit millisecond count'
    if browser.diagnostic-capacity <= 0 or browser.diagnostic-capacity > 2147483647
        throw chromium-error; 'diagnostic capacity must be a positive 32-bit count'
    timeout uint64 = 0
    capacity uint64 = 0
    try
        timeout = browser.timeout-ms
        capacity = browser.diagnostic-capacity
    catch integer-conversion-overflow as error
        throw chromium-error; move error.message
    launch-path native-pathbuf|none = none
    executable = browser.executable
    if executable == none
        try
            launch-path = default-executable;
        catch dependency-error as error
            throw chromium-error; 'could not find Chromium: ' + error.message
    else
        # chromium/projection-pathbuf: source text to PathBuf conversion is not
        # projected. Remove this typed conversion when PathBuf construction projects.
        launch-path = rust
            executable.as_deref().map(std::path::PathBuf::from)
    idle-timeout native-duration = native-duration::from_secs; 30
    empty-arguments list of string = list;
    options = instance native-launch-options; headless = true, sandbox = true, devtools = false, enable-gpu = false, enable-logging = false, window-size = none, port = none, ignore-certificate-errors = true, path = move launch-path, user-data-dir = none, extensions = empty-arguments, args = empty-arguments, ignore-default-args = empty-arguments, disable-default-args = false, idle-browser-timeout = move idle-timeout, process-envs = none, proxy-server = none
    tab-timeout native-duration = native-duration::from_millis; timeout
    try
        owner native-browser = native-browser::new; move options
        # A fresh tab avoids Chrome's privileged new-tab CSP blocking scripts in installed HTML.
        tab native-tab = owner.new_tab;
        tab.set_default_timeout; move tab-timeout
        events = capture-events; owner, tab, capacity, timeout
        state = instance page-state;
        state.browser = move owner
        state.tab = move tab
        state.events = move events
        state.timeout-ms = browser.timeout-ms
        managed = instance page; move state
        managed.set-viewport; viewport
        return shared ref managed
    catch dependency-error as error
        throw chromium-error; move error.message


private function page-navigate; target ref page, url ref string, loading ref load-options
    require-page; target.state
    deadline = page-deadline; target.state.timeout-ms
    request = instance Navigate; url = url
    request.referrer = none
    request.transition-Type = none
    request.frame-id = none
    request.referrer-policy = none
    response = target.send-navigation; move request
    if response.error-text != none
        throw chromium-error; 'navigation failed: ' + response.error-text
    download = response.is-download
    if download != none
        if download == true
            throw chromium-error; 'navigation started a download rather than a page'
    loader = response.loader-id
    if loader != none
        while true
            remaining-ms; deadline
            frame-request = instance GetFrameTree;
            frame-request.n0 = none
            frame = target.send-frame; move frame-request
            if frame.frame-tree.frame.loader-id == loader
                break
            poll-delay; deadline
    page-wait-until; target, 'document.readyState === "complete"', deadline
    page-readiness; target, loading, deadline

private function page-set-html; target ref page, html ref string, loading ref load-options
    require-page; target.state
    deadline = page-deadline; target.state.timeout-ms
    content string = html
    base-url = loading.base-url
    if base-url != none
        quoted-html = quote-js; html
        quoted-base-url = quote-js; base-url
        expression = '(()=>{const doc=new DOMParser().parseFromString(' + quoted-html + ',"text/html");const base=doc.createElement("base");base.href=' + quoted-base-url + ';doc.head.prepend(base);return (doc.doctype?new XMLSerializer().serializeToString(doc.doctype):"")+doc.documentElement.outerHTML;})()'
        prepared = page-evaluate-until; target, expression, false, deadline
        content = prepared.scalar
    frame-request = instance GetFrameTree;
    frame-request.n0 = none
    frame = target.send-frame; move frame-request
    request = instance SetDocumentContent; frame-id = frame.frame-tree.frame.id, html = content
    target.send-html; move request
    page-readiness; target, loading, deadline

private function page-readiness; target ref page, loading ref load-options, deadline int
    if loading.wait-for-assets
        page-evaluate-until; target, 'Promise.all(Array.from(document.images, i => i.decode())).then(() => document.fonts.ready).then(() => true)', true, deadline
    selector = loading.ready-selector
    if selector != none
        quoted = quote-js; selector
        page-wait-until; target, '!!document.querySelector(' + quoted + ')', deadline
    predicate = loading.ready-expression
    if predicate != none
        page-wait-until; target, '!!(' + predicate + ')', deadline

private function page-wait-until; target ref page, expression string, deadline int
    while true
        result = page-evaluate-until; target, expression, false, deadline
        if result.kind == 'bool' and result.scalar == 'true'
            return
        poll-delay; deadline

private function page-evaluate-until document-value; target ref page, expression string, await-promise bool, deadline int
    remaining = remaining-ms; deadline
    script = expression
    if await-promise
        script = '(()=>{const start=Date.now();const value=(' + expression + ');let timer;return Promise.race([Promise.resolve(value),new Promise((_,reject)=>{timer=setTimeout(()=>reject(new Error("JavaScript promise timed out")),Math.max(0,' + (remaining.to-string;) + '-(Date.now()-start)));})]).finally(()=>clearTimeout(timer));})()'
    request = instance Evaluate; expression = script
    request.object-group = none
    request.include-command-line-api = false
    request.silent = false
    request.context-id = none
    request.return-by-value = true
    request.generate-preview = false
    request.user-gesture = false
    request.await-promise = await-promise
    request.throw-on-side-effect = none
    request.timeout = remaining
    request.disable-breaks = none
    request.repl-mode = none
    request.allow-unsafe-eval-blocked-by-csp = none
    request.unique-context-id = none
    request.serialization-options = none
    response = target.send-evaluation; move request
    exception = ref response.exception-details
    if exception != none
        detail = ref exception.exception
        if detail != none
            description = detail.description
            if description != none
                throw chromium-error; 'JavaScript evaluation failed: ' + description
        throw chromium-error; 'JavaScript evaluation failed: ' + exception.text
    remote = ref response.result
    subtype = remote.subtype
    if subtype != none
        if subtype != (RemoteObjectSubtype::Null;) and subtype != (RemoteObjectSubtype::Array;)
            throw chromium-error; 'JavaScript returned a non-JSON object or an unawaited promise'
    value = ref remote.value
    if value != none
        try
            text = encode-native-json; value
            return decode-browser-json; text
        catch native-json-error as error
            throw chromium-error; 'JavaScript JSON serialization failed: ' + error.message
    if subtype != none
        if subtype == (RemoteObjectSubtype::Null;)
            return make-document-none;
    throw chromium-error; 'JavaScript returned a non-JSON value'

private function page-evaluate document-value; target ref page, expression ref string, await-promise bool
    require-page; target.state
    deadline = page-deadline; target.state.timeout-ms
    return page-evaluate-until; target, expression, await-promise, deadline

private function page-set-viewport; target ref page, viewport ref viewport-options
    require-page; target.state
    validate-viewport; viewport
    request = instance SetDeviceMetricsOverride; width = viewport.width, height = viewport.height, device-scale-factor = viewport.device-scale-factor, mobile = false
    request.scale = none
    request.screen-width = none
    request.screen-height = none
    request.position-x = none
    request.position-y = none
    request.dont-set-visible-size = none
    request.screen-orientation = none
    request.viewport = none
    target.send-viewport; move request

private function page-wait-selector; target ref page, selector ref string
    require-page; target.state
    deadline = page-deadline; target.state.timeout-ms
    quoted = quote-js; selector
    page-wait-until; target, '!!document.querySelector(' + quoted + ')', deadline

private function page-wait; target ref page, expression ref string
    require-page; target.state
    deadline = page-deadline; target.state.timeout-ms
    page-wait-until; target, '!!(' + expression + ')', deadline

private function page-screenshot bytes; target ref page, options ref screenshot-options
    require-page; target.state
    if options.format != 'png' and options.format != 'jpeg'
        throw chromium-error; 'screenshot format must be png or jpeg'
    quality = options.quality
    if quality != none
        if options.format != 'jpeg' or quality < 0 or quality > 100
            throw chromium-error; 'quality is only valid for JPEG and must be between 0 and 100'
    request = instance CaptureScreenshot;
    if options.format == 'png'
        request.format = (CaptureScreenshotFormatOption::Png;)
    else
        request.format = (CaptureScreenshotFormatOption::Jpeg;)
    request.quality = quality
    if options.full-page
        layout-request = instance GetLayoutMetrics;
        layout-request.n0 = none
        layout = target.send-layout; move layout-request
        size = layout.css-content-size
        clip = instance Viewport; x = 0.0, y = 0.0, width = size.width, height = size.height, scale = 1.0
        request.clip = clip
    else
        request.clip = none
    request.from-surface = true
    request.capture-beyond-viewport = options.full-page
    request.optimize-for-speed = none
    response = target.send-screenshot; move request
    encoded = ref response.data
    decoded = decode-base64; encoded, false, true
    if decoded.failed
        throw chromium-error; 'could not decode screenshot: ' + decoded.message
    return move decoded.value

private function page-print bytes; target ref page, printing ref pdf-options
    require-page; target.state
    dimensions = pdf-paper; printing
    if printing.expand-disclosures
        disclosure-deadline = page-deadline; target.state.timeout-ms
        page-evaluate-until; target, 'document.querySelectorAll("details").forEach(e => e.open = true); true', false, disclosure-deadline
    assets-deadline = page-deadline; target.state.timeout-ms
    page-evaluate-until; target, 'Promise.all(Array.from(document.images, i => i.decode())).then(() => document.fonts.ready).then(() => true)', true, assets-deadline
    top = millimetres-to-inches; printing.margin-top-mm
    bottom = millimetres-to-inches; printing.margin-bottom-mm
    left = millimetres-to-inches; printing.margin-left-mm
    right = millimetres-to-inches; printing.margin-right-mm
    request = instance PrintToPDF;
    request.landscape = printing.landscape
    request.display-header-footer = printing.display-header-footer
    request.print-background = printing.print-background
    request.scale = printing.scale
    request.paper-width = dimensions.width
    request.paper-height = dimensions.height
    request.margin-top = top
    request.margin-bottom = bottom
    request.margin-left = left
    request.margin-right = right
    request.page-ranges = printing.page-ranges
    request.header-template = none
    request.footer-template = none
    request.prefer-css-page-size = printing.prefer-css-page-size
    request.transfer-mode = none
    request.generate-tagged-pdf = none
    request.generate-document-outline = none
    response = target.send-print; move request
    encoded = ref response.data
    decoded = decode-base64; encoded, false, true
    if decoded.failed
        throw chromium-error; decoded.message
    return move decoded.value

private function page-diagnostics document-value; target ref page
    require-page; target.state
    deadline = page-deadline; target.state.timeout-ms
    document = page-evaluate-until; target, '({url:location.href,title:document.title,timing:performance.getEntriesByType("navigation")[0]?.toJSON() ?? null,resources:performance.getEntriesByType("resource").map(e=>e.toJSON())})', false, deadline
    events = target.state.events
    if events != none
        return page-diagnostics-with-events; target, events, document
    throw chromium-error; 'browser diagnostic capture stopped'

private function page-diagnostics-with-events document-value; target ref page, events ref (native-event-receiver of string), document ref document-value
    available int = events.len;
    capacity int|none = events.capacity;
    capacity-reached bool = false
    if capacity != none
        capacity-reached = capacity == available
    records list of document-value = list;
    to-read = available
    if to-read == 0
        to-read = 1
    index int = 0
    while index < to-read
        polled event-poll = rust
            {
                let (text, stopped) = crate::chromium_backend::poll_event(events);
                EventPoll { text, stopped }
            }
        if polled.stopped
            throw chromium-error; 'browser diagnostic capture stopped'
        event-text string|none = rust
            polled.text
        if event-text != none
            parsed = parse-json; move event-text, (default-json-options;)
            if parsed.failed
                throw chromium-error; 'invalid diagnostic event: ' + parsed.message
            event = move parsed.value
            kind = document-field; event, 'kind'
            if kind.scalar == 'capture-error'
                detail = document-field; event, 'message'
                throw chromium-error; 'browser diagnostic capture failed: ' + detail.scalar
            records.append; move event
            index = index + 1
        else
            if available > 0
                throw chromium-error; 'browser diagnostic capture stopped'
            break
    timing = document-field; document, 'timing'
    status = make-document-none;
    if not target.state.injected-html
        status = document-field; timing, 'responseStatus'
        # Integer text is canonical signed decimal: compared with "0", its sign exactly tests positivity without narrowing or parsing.
        if status.kind != 'integer' or status.integer.text <= '0'
            status = make-document-none;
        if status.kind == 'none'
            target-url = document-field; timing, 'name'
            index = records.length - 1
            while index >= 0
                record = ref records[index]
                kind = document-field; record, 'kind'
                resource-type = document-field; record, 'resource-type'
                event-url = document-field; record, 'url'
                event-status = document-field; record, 'status'
                if kind.kind == 'string' and kind.scalar == 'response' and resource-type.kind == 'string' and resource-type.scalar == 'Document' and target-url.kind == 'string' and event-url.kind == 'string' and event-url.scalar == target-url.scalar and event-status.kind == 'integer' and event-status.integer.text > '0'
                    status = event-status
                    break
                index = index - 1
    event-list = make-document-list; records
    if event-list.failed
        throw chromium-error; 'could not construct browser diagnostics'
    entries = instance document-map-entries;
    entries.append; 'url', (document-field; document, 'url')
    entries.append; 'title', (document-field; document, 'title')
    entries.append; 'status', status
    entries.append; 'navigation-timing', timing
    entries.append; 'resource-timings', (document-field; document, 'resources')
    entries.append; 'events', event-list.value
    entries.append; 'capacity-reached', (make-document-bool; capacity-reached)
    result = make-document-map; entries
    if result.failed
        throw chromium-error; 'could not construct browser diagnostics'
    return move result.value

private function page-close string; state ref page-state
    # Preserve source-owned cleanup in page.close, using the projected receiver
    # and throwable boundary rather than a package-local native adapter.
    tab = state.tab
    if tab != none
        try
            tab.close; false
        catch dependency-error as error
            return error.message
    return ''
